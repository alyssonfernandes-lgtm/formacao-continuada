{
  "name": "formacao-continuada",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma municipal de formação continuada da educação",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch --env-file=.env src/server/index.ts\" \"vite --config vite.config.ts\"",
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.server.json && node -e \"require('fs').cpSync('src/server/db/migrations','dist/server/server/db/migrations',{recursive:true});require('fs').cpSync('src/server/assets','dist/server/server/assets',{recursive:true})\"",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "worker": "node --env-file-if-exists=.env dist/server/server/worker-main.js",
    "migrate": "tsx --env-file=.env src/server/db/migrate-cli.ts",
    "create-admin": "tsx --env-file=.env src/server/scripts/create-admin.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:smtp": "tsx src/server/scripts/dev-smtp.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "argon2": "^0.45.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.8",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/smtp-server": "^3.5.10",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jsqr": "^1.4.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "smtp-server": "^3.13.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
