# Alternativa ao Caddy: Nginx como proxy reverso com HTTPS (certificado via certbot).
server {
    listen 80;
    server_name formacao.exemplo.gov.br;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name formacao.exemplo.gov.br;
    ssl_certificate     /etc/letsencrypt/live/formacao.exemplo.gov.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/formacao.exemplo.gov.br/privkey.pem;
    client_max_body_size 4m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
