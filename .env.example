# ===== Aplicação =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Endereço público (com https em produção). Usado nos links dos e-mails, QR Codes e certificados.
PUBLIC_URL=https://formacao.exemplo.gov.br
# Defina como true quando a aplicação estiver atrás de proxy reverso (Nginx, Caddy, balanceador)
TRUST_PROXY=true
LOG_LEVEL=info
# Opcional: cria o primeiro administrador ao iniciar, somente se ainda não houver usuários. Remova depois do primeiro acesso.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ===== Banco de dados =====
DATABASE_URL=postgres://formacao:SENHA_FORTE@localhost:5432/formacao

# ===== Chaves de proteção de dados (obrigatórias) =====
# Gere cada uma com: openssl rand -hex 32
# ATENÇÃO: perder DATA_ENCRYPTION_KEY torna os CPFs e tokens cifrados irrecuperáveis. Guarde em cofre de segredos.
DATA_ENCRYPTION_KEY=
CPF_HMAC_KEY=

# ===== Sessão do painel =====
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60

# ===== E-mail transacional (SMTP) =====
# Sem SMTP_HOST e SMTP_FROM os e-mails permanecem "pendentes" na fila (nada é dado como enviado).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Formação Continuada <nao-responda@exemplo.gov.br>"

# ===== Fila =====
# true: a fila roda dentro do servidor web. false: execute "npm run worker" em processo separado.
WORKER_INLINE=true
WORKER_POLL_MS=5000
